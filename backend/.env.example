# === SmartTicket backend — variables d'environnement ===

PORT=3001

# Base de données (doit correspondre à database/smartticket_schema_v1.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_me
DB_NAME=smartticket_v1

# Auth JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=3600s

# Environnement : development (défaut) | production | test
# En production : JWT_SECRET >= 32 caractères (valeurs d'exemple refusées) et CORS_ORIGINS obligatoire.
NODE_ENV=development

# Origines autorisées par CORS, séparées par des virgules (jamais de « * »)
CORS_ORIGINS=http://localhost:3000

# Rate limit du login/bootstrap : LIMIT requêtes par fenêtre de TTL secondes, par IP
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL=60

# --- Cache Redis (optionnel) ---------------------------------------------------
# REDIS_HOST vide = pas de Redis : l'application fonctionne comme avant
# (cache désactivé, compteurs de rate limit en mémoire).
# Local (Laragon) : REDIS_HOST=localhost
# AWS : endpoint ElastiCache ou IP privée de l'EC2 Redis.
REDIS_HOST=
REDIS_PORT=6379
# Laisser vide si Redis n'a pas de mot de passe.
REDIS_PASSWORD=
# Durée de vie des entrées en cache (secondes).
CACHE_TTL_SECONDS=300

# === Phase 3 : invitations technicien + email ===
# URL du frontend : sert de base au lien « /invite/accept?token=… » envoyé par mail
FRONTEND_URL=http://localhost:3000
# Durée de validité d'une invitation (heures)
INVITATION_TTL_HOURS=72

# PASSWORD_RESET_TTL_MINUTES : validité du lien « mot de passe oublié » (défaut 60).
# PASSWORD_RESET_TTL_MINUTES=60

# MAIL_MODE : smtp = envoi réel | log = le lien est affiché dans la console du backend (dev).
# Si MAIL_MODE est absent : smtp quand MAIL_USER et MAIL_PASSWORD sont

# --- Stockage de fichiers S3 (optionnel) ----------------------------------------
# S3_BUCKET vide = pas de S3 : les logos sont enregistrés dans le dossier local uploads/.
# Nom COMPLET du bucket (avec le suffixe -<id-compte>-<région>-an si namespace régional).
# Aucune clé AWS ici : en local, les identifiants viennent de ~/.aws/credentials ;
# sur EC2, du rôle IAM de l'instance (LabInstanceProfile).
S3_BUCKET=
AWS_REGION=